@echo off
chcp 65001 >nul
echo ============================================================
echo   กำลังเริ่มต้นระบบฐานข้อมูล PostgreSQL บน Docker...
echo ============================================================
echo.

docker compose up -d db

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ============================================================
    echo   [SUCCESS] ฐานข้อมูล PostgreSQL กำลังทำงานเรียบร้อยแล้ว!
    echo   - Host: localhost
    echo   - Port: 5432
    echo   - Database: university_maintenance
    echo   - User: postgres
    echo   - Password: postgres
    echo   - โครงสร้างตารางและข้อมูลเริ่มต้นถูกสร้างอัตโนมัติเรียบร้อย!
    echo ============================================================
) else (
    echo.
    echo ============================================================
    echo   [คำแนะนำ] หากเกิดข้อผิดพลาด:
    echo   กรุณาเปิดโปรแกรม Docker Desktop บนคอมพิวเตอร์ของคุณก่อน
    echo   แล้วดับเบิลคลิกไฟล์นี้ใหม่อีกครั้งครับ
    echo ============================================================
)
echo.
pause
