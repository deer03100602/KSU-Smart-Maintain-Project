PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/university_maintenance?schema=public"

# ============================================================
# Discord Multi-Channel Webhooks (Server-Side Secrets)
# ข้อกำหนด: ห้ามนำ URL จริงไป commit บน GitHub
# ให้ใส่ Webhook URL ของแต่ละห้องที่สร้างไว้ใน Discord ของคุณ
# ============================================================
DISCORD_WEBHOOK_URGENT="https://discord.com/api/webhooks/YOUR_URGENT_WEBHOOK"        # ห้อง: แจ้งเตือนเร่งด่วน
DISCORD_WEBHOOK_PAYMENT="https://discord.com/api/webhooks/YOUR_PAYMENT_WEBHOOK"      # ห้อง: ยอดเงินและการชำระเงิน
DISCORD_WEBHOOK_NEW_ORDER="https://discord.com/api/webhooks/YOUR_NEW_ORDER_WEBHOOK"  # ห้อง: ออเดอร์ใหม่ / งานแจ้งซ่อมใหม่
DISCORD_WEBHOOK_ERROR="https://discord.com/api/webhooks/YOUR_ERROR_WEBHOOK"          # ห้อง: ข้อผิดพลาดของระบบ
DISCORD_WEBHOOK_ACTIVITY="https://discord.com/api/webhooks/YOUR_ACTIVITY_WEBHOOK"    # ห้อง: activity-logs (บันทึกกิจกรรม)

# ============================================================
# Email Notification Settings (Optional)
# ============================================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ============================================================
# LINE Official Account / LINE Messaging API (Server-Side Secrets)
# ข้อกำหนด: ห้ามนำ Token หรือ Secret จริงไป commit บน GitHub
# 1. สมัคร/สร้าง Messaging API Channel ที่ https://developers.line.biz/
# 2. นำ Channel Access Token (long-lived) มาใส่ที่ LINE_CHANNEL_ACCESS_TOKEN
# 3. นำ Channel Secret มาใส่ที่ LINE_CHANNEL_SECRET (สำหรับตรวจสอบ Webhook)
# 4. นำ Group ID (ขึ้นต้นด้วย C.../R...) หรือ User ID (ขึ้นต้นด้วย U...) มาใส่ที่ LINE_TARGET_ID
# ============================================================
LINE_NOTIFY_ENABLED="true"
LINE_CHANNEL_ACCESS_TOKEN="YOUR_LINE_CHANNEL_ACCESS_TOKEN_HERE"
LINE_CHANNEL_SECRET="YOUR_LINE_CHANNEL_SECRET_HERE"
LINE_TARGET_ID="YOUR_LINE_GROUP_ID_OR_USER_ID_HERE"
APP_BASE_URL="http://localhost:5173"

