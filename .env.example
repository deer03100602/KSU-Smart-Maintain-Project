# ============================================================
# KSU Smart Maintain - Production Environment Configuration
# ============================================================

PORT=5000

# Optional: PostgreSQL Database (if not provided, system uses resilient local JSON storage)
DATABASE_URL="postgresql://postgres:password@localhost:5432/university_maintenance?schema=public"

# JWT Secret
JWT_SECRET="ksu_smart_maintain_jwt_secret_2026"

# LINE Messaging API (Optional - can also configure via Admin Settings UI)
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
LINE_GROUP_ID=""

# Email SMTP Notification (Optional - can also configure via Admin Settings UI)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""

# Discord Webhook Notifications (Optional)
DISCORD_WEBHOOK_URGENT=""
DISCORD_WEBHOOK_PAYMENT=""
DISCORD_WEBHOOK_NEW_ORDER=""
DISCORD_WEBHOOK_ERROR=""
DISCORD_WEBHOOK_ACTIVITY=""
